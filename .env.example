# Pflicht: festes JWT-Secret (mindestens 32 Zeichen, kein Platzhalter-Wortlaut)
# Beispiel erzeugen: openssl rand -hex 32
SSH_SYNC_JWT_SECRET=

# Ersteinrichtung absichern (Header X-Setup-Token bei POST /api/setup)
SSH_SYNC_SETUP_TOKEN=

# Oeffentliche HTTPS-Basis fuer Install-Skripte (ohne Pfad)
SSH_SYNC_PUBLIC_URL=https://portal.example

# Optional: Cloudflare Access Service Token im Portal anzeigen (Geraete-Setup-Dialog)
SSH_SYNC_CF_ACCESS_CLIENT_ID=
SSH_SYNC_CF_ACCESS_CLIENT_SECRET=
